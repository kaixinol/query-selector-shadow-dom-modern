{
  "name": "query-selector-shadow-dom-modern",
  "version": "1.0.0",
  "description": "Modern drop-in replacement for query-selector-shadow-dom — querySelector that pierces Shadow DOM roots without knowing the path",
  "type": "module",
  "main": "dist/umd/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/umd/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build:esm": "tsc -p tsconfig.json",
    "build:umd": "rollup -c",
    "build": "pnpm build:esm && pnpm build:umd",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "shadowdom",
    "queryselector",
    "webcomponents",
    "puppeteer",
    "playwright",
    "automation",
    "webdriver",
    "testing"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.62.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
