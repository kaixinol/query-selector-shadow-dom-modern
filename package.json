{
  "name": "query-selector-shadow-dom-modern",
  "version": "1.0.0",
  "description": "Modern drop-in replacement for query-selector-shadow-dom — querySelector that pierces Shadow DOM roots without knowing the path",
  "type": "module",
  "main": "dist/umd/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/umd/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build:esm": "tsc -p tsconfig.json",
    "build:umd": "rollup -c",
    "build": "pnpm build:esm && pnpm build:umd",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx benchmark/runner.ts",
    "verify": "tsx benchmark/verify.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "shadowdom",
    "queryselector",
    "webcomponents",
    "puppeteer",
    "playwright",
    "automation",
    "webdriver",
    "testing"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.0",
    "query-selector-shadow-dom": "^1.0.1",
    "rollup": "^4.34.8",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
